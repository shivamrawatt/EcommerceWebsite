{
  "$schema": "https://openship.io/openship.schema.json",
  "monorepo": {
    "apps": [
    
     
      {
        "name": "backend",
        "rootDirectory": "backend",
        "framework": "express",
        "runtime": "docker",
        "port": 5000
      },
     
        {
        "name": "frontend",
        "rootDirectory": "frontend",
        "framework": "vite",
        "buildCommand": "npm run build",
        "outputDirectory": "dist",
        "productionMode": "static"
      },
      {
        "name": "admin",
        "rootDirectory": "admin",
        "framework": "vite",
        "buildCommand": "npm run build",
        "outputDirectory": "dist",
        "productionMode": "static"
      }
     
    ]
  }
}